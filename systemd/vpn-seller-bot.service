[Unit]
Description=VPN Seller Telegram Bot
After=network.target vpn-core-xray.service
Wants=vpn-core-xray.service

[Service]
Type=simple
User=vpn-bot
Group=vpn-bot
WorkingDirectory=/opt/vpn-seller-bot
EnvironmentFile=/opt/vpn-seller-bot/.env
ExecStart=/opt/vpn-seller-bot/.venv/bin/python3 /opt/vpn-seller-bot/bot.py
Restart=always
RestartSec=3
ProtectHome=yes
ReadWritePaths=/opt/vpn-seller-bot /opt/vpn-seller-bot/data /opt/vpn-seller-bot/backups /opt/vpn-core/conf

[Install]
WantedBy=multi-user.target
